# ==========================================
# EVI ADVOGADOS - CONFIGURAÇÃO DE AMBIENTE
# ==========================================

# Repositório Oficial do Projeto
PROJECT_GIT_REPO="https://github.com/ag-Codevision/evi_adv.git"

# Supabase (PostgreSQL Gerenciado + Storage + Auth)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Motor de Inteligência Artificial Editorial (NVIDIA NIM)
# Modelo ativo e verificado para produção jurídica: meta/llama-3.2-90b-vision-instruct
NVIDIA_API_KEY="nvapi-sua-chave"
NVIDIA_MODEL="meta/llama-3.2-90b-vision-instruct"

# Banco de Imagens Gratuitas
# Provedor padrão: Unsplash API (ou fallback automático de curadoria em alta resolução)
UNSPLASH_ACCESS_KEY="sua-chave-unsplash"
